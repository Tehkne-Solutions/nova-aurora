{
  "name": "@nova-aurora/database",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./creator-player-economy-settlement": {
      "types": "./dist/creator-player-economy-settlement.d.ts",
      "import": "./dist/creator-player-economy-settlement.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 src/*.test.ts && node ../../scripts/validate-sprint19.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": { "postgres": "^3.4" },
  "devDependencies": { "@types/node": "^22", "tsx": "^4", "typescript": "^5.9" }
}
