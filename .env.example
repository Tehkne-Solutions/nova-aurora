NODE_ENV=development
DATABASE_URL=postgresql://nova_aurora:nova_aurora@localhost:5432/nova_aurora
REDIS_URL=redis://localhost:6379
INTERNAL_API_TOKEN=replace-with-at-least-24-characters
DATA_ENCRYPTION_KEY=replace-with-at-least-32-characters
ALLOW_RECOVERY_TOKEN_RESPONSE=true
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_REGISTRATION_MODE=open
TRANSACTIONAL_EMAIL_ENDPOINT=
