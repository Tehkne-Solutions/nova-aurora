TRANSACTIONAL_EMAIL_TOKEN=replace-with-at-least-24-characters
TRUST_ENFORCEMENT_MODE=report-only
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGINS=http://localhost:3000
TRUST_PROXY=false
API_PORT=4000
ECONOMY_TICK_SECONDS=60
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ENDPOINT=http://localhost:8333
OBJECT_STORAGE_BUCKET=nova-aurora-ugc
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=nova-aurora-dev
