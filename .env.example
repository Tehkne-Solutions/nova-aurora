TRANSACTIONAL_EMAIL_TOKEN=replace-with-at-least-24-characters
TRUST_ENFORCEMENT_MODE=report-only
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGINS=http://localhost:3000
TRUST_PROXY=false
API_PORT=4000
ECONOMY_TICK_SECONDS=60
