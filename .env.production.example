DOMAIN=nova-aurora.example.com
ACME_EMAIL=infra@example.com
POSTGRES_DB=nova_aurora
POSTGRES_USER=nova_aurora
IMAGE_REGISTRY=ghcr.io/tehkne-solutions
IMAGE_TAG=latest
APP_VERSION=0.19.0
GIT_COMMIT_SHA=replace-with-deployment-commit
LOG_LEVEL=info
ECONOMY_TICK_SECONDS=60
BETA_TELEMETRY_RETENTION_DAYS=30
PROMETHEUS_RETENTION=15d
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
GRAFANA_ADMIN_USER=admin
ENABLE_BOB_IN_PRODUCTION=false
ALLOW_RECOVERY_TOKEN_RESPONSE=false
PUBLIC_WEB_URL=https://nova-aurora.example.com
PUBLIC_API_URL=https://api.nova-aurora.example.com
PUBLIC_REGISTRATION_MODE=invite-only
BETA_ROLLOUT_MODE=controlled
TRANSACTIONAL_EMAIL_ENDPOINT=https://email-provider.example.com/v1/send
TRANSACTIONAL_EMAIL_FROM=Nova Aurora <no-reply@nova-aurora.example.com>
TRUST_ENFORCEMENT_MODE=required
# Object storage e ingestão binária permanecem opt-in até o ambiente possuir secrets e scanner operacional.
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=http://object-storage:8333
OBJECT_STORAGE_BUCKET=nova-aurora-ugc
OBJECT_STORAGE_REGION=us-east-1
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_HOST=clamav
MALWARE_SCAN_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=30000
SECRETS_DIR=./secrets
