DOMAIN=nova-aurora.example.com
ACME_EMAIL=infra@example.com
POSTGRES_DB=nova_aurora
POSTGRES_USER=nova_aurora
IMAGE_REGISTRY=ghcr.io/tehkne-solutions
IMAGE_TAG=latest
APP_VERSION=0.12.0
GIT_COMMIT_SHA=replace-with-deployment-commit
LOG_LEVEL=info
ECONOMY_TICK_SECONDS=60
PROMETHEUS_RETENTION=15d
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
GRAFANA_ADMIN_USER=admin
ENABLE_BOB_IN_PRODUCTION=false
SECRETS_DIR=./secrets
